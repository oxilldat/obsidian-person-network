	"repository": {
		"type": "git",
		"url": "git+https://github.com/oxilldat/obsidian-person-network.git"
	},
	"bugs": { "url": "https://github.com/oxilldat/obsidian-person-network/issues" },
	"homepage": "https://github.com/oxilldat/obsidian-person-network#readme",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.7.2",
		"vitest": "^2.1.0"
	},
	"dependencies": {}
